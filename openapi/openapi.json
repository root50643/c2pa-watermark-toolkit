            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "regions": {
            "type": "string",
            "title": "Regions",
            "description": "JSON: [[x,y,width,height]] or [{\"x\":0,\"y\":0,\"width\":10,\"height\":10}]"
          },
          "backend": {
            "type": "string",
            "enum": [
              "cv2",
              "migan",
              "lama"
            ],
            "title": "Backend",
            "default": "cv2"
          },
          "method": {
            "type": "string",
            "enum": [
              "telea",
              "ns"
            ],
            "title": "Method",
            "default": "telea"
          },
          "dilate": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Dilate",
            "default": 3
          },
          "strip_metadata": {
            "type": "boolean",
            "title": "Strip Metadata",
            "default": true
          }
        },
        "type": "object",
        "required": [
