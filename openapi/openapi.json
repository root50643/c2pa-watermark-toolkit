  "components": {
    "schemas": {
      "Body_all_job_api_v1_jobs_all_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "pipeline": {
            "type": "string",
            "enum": [
              "controlnet",
              "sdxl",
              "qwen"
            ],
            "title": "Pipeline",
            "default": "controlnet"
          },
          "strength": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Strength"
          },
          "steps": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Steps",
            "default": 50
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "auto",
              "strict",
              "assume_ai"
            ],
            "title": "Sensitivity",
            "default": "auto"
          },
          "backend": {
            "type": "string",
            "enum": [
              "cv2",
              "migan",
              "lama"
            ],
            "title": "Backend",
            "default": "cv2"
          },
          "max_resolution": {
            "type": "integer",
            "maximum": 8192.0,
            "minimum": 0.0,
            "title": "Max Resolution",
            "default": 0
          },
          "min_resolution": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 0.0,
            "title": "Min Resolution",
            "default": 1024
          },
          "tile": {
            "type": "boolean",
            "title": "Tile",
            "default": false
          },
          "tile_size": {
            "type": "integer",
            "maximum": 2048.0,
            "minimum": 512.0,
            "title": "Tile Size",
            "default": 1024
          },
          "tile_overlap": {
            "type": "integer",
            "maximum": 512.0,
            "minimum": 0.0,
            "title": "Tile Overlap",
            "default": 128
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_all_job_api_v1_jobs_all_post"
      },
      "Body_erase_endpoint_api_v1_remove_erase_post": {
        "properties": {
